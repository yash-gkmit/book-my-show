{
  "name": "book-my-show-project",
  "version": "1.0.0",
  "description": "This project aims to develop a backend API system for a movie ticket booking application, similar to BookMyShow. The system will cater to three user roles: admin, theatre owners, and customers. The focus is on creating a robust API structure without frontend implementation.",
  "main": "index.js",
  "scripts": {
    "start": "nodemon index.js",
    "format": "npx prettier --write \"./**/*.{js,jsx}\"",
    "lint": "npx eslint ./",
    "test": "jest --coverage",
    "migration:generate": "npx sequelize-cli migration:generate --name",
    "migration:create": "npx sequelize-cli migration:create --name",
    "migration:up": "npx sequelize-cli db:migrate",
    "migration:down": "npx sequelize-cli db:migrate:undo",
    "migration:down:all": "npx sequelize-cli db:migrate:undo:all",
    "seed:generate": "npx sequelize-cli seed:generate --name",
    "seed:all": "npx sequelize-cli db:seed:all",
    "seed:undo": "npx sequelize-cli db:seed:undo --seed",
    "seed:undo:all": "npx sequelize-cli db:seed:undo:all"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/yash-gkmit/book-my-show.git"
  },
  "author": "Yash Gupta",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/yash-gkmit/book-my-show/issues"
  },
  "homepage": "https://github.com/yash-gkmit/book-my-show#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.689.0",
    "@faker-js/faker": "^9.2.0",
    "aws-sdk": "^2.1692.0",
    "bcryptjs": "^2.4.3",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-validator": "^7.2.0",
    "joi": "^17.13.3",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "otp-generator": "^4.0.1",
    "parse": "^5.3.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "redis": "^4.7.0",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.0.0",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "faker": "^6.6.6",
    "globals": "^15.12.0",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7"
  }
}
